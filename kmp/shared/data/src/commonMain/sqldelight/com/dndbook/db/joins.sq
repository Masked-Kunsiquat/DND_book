-- ─────────────────────────────────────────────────────────────────────────────
-- location_images queries
-- ─────────────────────────────────────────────────────────────────────────────

insertLocationImage:
INSERT OR IGNORE INTO location_images(id, location_id, blob_hash, sort_order) VALUES (?, ?, ?, ?);

deleteLocationImage:
DELETE FROM location_images WHERE id = ?;

selectImagesByLocation:
SELECT * FROM location_images WHERE location_id = ? ORDER BY sort_order ASC;

selectAllBlobHashes:
SELECT blob_hash FROM location_images;

