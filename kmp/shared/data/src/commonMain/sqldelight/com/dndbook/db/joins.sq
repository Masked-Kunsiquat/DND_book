-- Join tables for all entity relationships

CREATE TABLE note_campaigns (
  note_id     TEXT NOT NULL REFERENCES notes(id) ON DELETE CASCADE,
  campaign_id TEXT NOT NULL REFERENCES campaigns(id) ON DELETE CASCADE,
  PRIMARY KEY (note_id, campaign_id)
);

CREATE TABLE note_locations (
  note_id     TEXT NOT NULL REFERENCES notes(id) ON DELETE CASCADE,
  location_id TEXT NOT NULL REFERENCES locations(id) ON DELETE CASCADE,
  PRIMARY KEY (note_id, location_id)
);

CREATE TABLE note_tags (
  note_id TEXT NOT NULL REFERENCES notes(id) ON DELETE CASCADE,
  tag_id  TEXT NOT NULL REFERENCES tags(id) ON DELETE CASCADE,
  PRIMARY KEY (note_id, tag_id)
);

CREATE TABLE npc_campaigns (
  npc_id      TEXT NOT NULL REFERENCES npcs(id) ON DELETE CASCADE,
  campaign_id TEXT NOT NULL REFERENCES campaigns(id) ON DELETE CASCADE,
  PRIMARY KEY (npc_id, campaign_id)
);

CREATE TABLE npc_locations (
  npc_id      TEXT NOT NULL REFERENCES npcs(id) ON DELETE CASCADE,
  location_id TEXT NOT NULL REFERENCES locations(id) ON DELETE CASCADE,
  PRIMARY KEY (npc_id, location_id)
);

CREATE TABLE npc_notes (
  npc_id  TEXT NOT NULL REFERENCES npcs(id) ON DELETE CASCADE,
  note_id TEXT NOT NULL REFERENCES notes(id) ON DELETE CASCADE,
  PRIMARY KEY (npc_id, note_id)
);

CREATE TABLE npc_tags (
  npc_id TEXT NOT NULL REFERENCES npcs(id) ON DELETE CASCADE,
  tag_id TEXT NOT NULL REFERENCES tags(id) ON DELETE CASCADE,
  PRIMARY KEY (npc_id, tag_id)
);

CREATE TABLE location_campaigns (
  location_id TEXT NOT NULL REFERENCES locations(id) ON DELETE CASCADE,
  campaign_id TEXT NOT NULL REFERENCES campaigns(id) ON DELETE CASCADE,
  PRIMARY KEY (location_id, campaign_id)
);

CREATE TABLE location_tags (
  location_id TEXT NOT NULL REFERENCES locations(id) ON DELETE CASCADE,
  tag_id      TEXT NOT NULL REFERENCES tags(id) ON DELETE CASCADE,
  PRIMARY KEY (location_id, tag_id)
);

CREATE TABLE location_images (
  id          TEXT PRIMARY KEY NOT NULL,
  location_id TEXT NOT NULL REFERENCES locations(id) ON DELETE CASCADE,
  blob_hash   TEXT NOT NULL,
  sort_order  INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE item_campaigns (
  item_id     TEXT NOT NULL REFERENCES items(id) ON DELETE CASCADE,
  campaign_id TEXT NOT NULL REFERENCES campaigns(id) ON DELETE CASCADE,
  PRIMARY KEY (item_id, campaign_id)
);

CREATE TABLE item_tags (
  item_id TEXT NOT NULL REFERENCES items(id) ON DELETE CASCADE,
  tag_id  TEXT NOT NULL REFERENCES tags(id) ON DELETE CASCADE,
  PRIMARY KEY (item_id, tag_id)
);

CREATE TABLE session_locations (
  session_id  TEXT NOT NULL REFERENCES session_logs(id) ON DELETE CASCADE,
  location_id TEXT NOT NULL REFERENCES locations(id) ON DELETE CASCADE,
  PRIMARY KEY (session_id, location_id)
);

CREATE TABLE session_npcs (
  session_id TEXT NOT NULL REFERENCES session_logs(id) ON DELETE CASCADE,
  npc_id     TEXT NOT NULL REFERENCES npcs(id) ON DELETE CASCADE,
  PRIMARY KEY (session_id, npc_id)
);

CREATE TABLE session_notes (
  session_id TEXT NOT NULL REFERENCES session_logs(id) ON DELETE CASCADE,
  note_id    TEXT NOT NULL REFERENCES notes(id) ON DELETE CASCADE,
  PRIMARY KEY (session_id, note_id)
);

CREATE TABLE session_player_characters (
  session_id          TEXT NOT NULL REFERENCES session_logs(id) ON DELETE CASCADE,
  player_character_id TEXT NOT NULL REFERENCES player_characters(id) ON DELETE CASCADE,
  PRIMARY KEY (session_id, player_character_id)
);

CREATE TABLE session_items (
  session_id TEXT NOT NULL REFERENCES session_logs(id) ON DELETE CASCADE,
  item_id    TEXT NOT NULL REFERENCES items(id) ON DELETE CASCADE,
  PRIMARY KEY (session_id, item_id)
);

CREATE TABLE session_tags (
  session_id TEXT NOT NULL REFERENCES session_logs(id) ON DELETE CASCADE,
  tag_id     TEXT NOT NULL REFERENCES tags(id) ON DELETE CASCADE,
  PRIMARY KEY (session_id, tag_id)
);

CREATE TABLE pc_campaigns (
  player_character_id TEXT NOT NULL REFERENCES player_characters(id) ON DELETE CASCADE,
  campaign_id         TEXT NOT NULL REFERENCES campaigns(id) ON DELETE CASCADE,
  PRIMARY KEY (player_character_id, campaign_id)
);

CREATE TABLE pc_notes (
  player_character_id TEXT NOT NULL REFERENCES player_characters(id) ON DELETE CASCADE,
  note_id             TEXT NOT NULL REFERENCES notes(id) ON DELETE CASCADE,
  PRIMARY KEY (player_character_id, note_id)
);

-- ─────────────────────────────────────────────────────────────────────────────
-- Indices: the compound PK covers the first column; the second FK column needs
-- its own index so ON DELETE CASCADE from the referenced parent doesn't scan.
-- ─────────────────────────────────────────────────────────────────────────────

CREATE INDEX idx_note_campaigns_campaign ON note_campaigns(campaign_id);
CREATE INDEX idx_note_locations_location ON note_locations(location_id);
CREATE INDEX idx_note_tags_tag ON note_tags(tag_id);
CREATE INDEX idx_npc_campaigns_campaign ON npc_campaigns(campaign_id);
CREATE INDEX idx_npc_locations_location ON npc_locations(location_id);
CREATE INDEX idx_npc_notes_note ON npc_notes(note_id);
CREATE INDEX idx_npc_tags_tag ON npc_tags(tag_id);
CREATE INDEX idx_location_campaigns_campaign ON location_campaigns(campaign_id);
CREATE INDEX idx_location_tags_tag ON location_tags(tag_id);
CREATE INDEX idx_location_images_location ON location_images(location_id);
CREATE INDEX idx_item_campaigns_campaign ON item_campaigns(campaign_id);
CREATE INDEX idx_item_tags_tag ON item_tags(tag_id);
CREATE INDEX idx_session_locations_location ON session_locations(location_id);
CREATE INDEX idx_session_npcs_npc ON session_npcs(npc_id);
CREATE INDEX idx_session_notes_note ON session_notes(note_id);
CREATE INDEX idx_session_pcs_pc ON session_player_characters(player_character_id);
CREATE INDEX idx_session_items_item ON session_items(item_id);
CREATE INDEX idx_session_tags_tag ON session_tags(tag_id);
CREATE INDEX idx_pc_campaigns_campaign ON pc_campaigns(campaign_id);
CREATE INDEX idx_pc_notes_note ON pc_notes(note_id);

-- ─────────────────────────────────────────────────────────────────────────────
-- note_campaigns queries
-- ─────────────────────────────────────────────────────────────────────────────

insertNoteCampaign:
INSERT OR IGNORE INTO note_campaigns(note_id, campaign_id) VALUES (?, ?);

deleteNoteCampaign:
DELETE FROM note_campaigns WHERE note_id = ? AND campaign_id = ?;

selectCampaignsByNote:
SELECT campaign_id FROM note_campaigns WHERE note_id = ?;

selectNotesByCampaignJoin:
SELECT note_id FROM note_campaigns WHERE campaign_id = ?;

-- ─────────────────────────────────────────────────────────────────────────────
-- note_locations queries
-- ─────────────────────────────────────────────────────────────────────────────

insertNoteLocation:
INSERT OR IGNORE INTO note_locations(note_id, location_id) VALUES (?, ?);

deleteNoteLocation:
DELETE FROM note_locations WHERE note_id = ? AND location_id = ?;

selectLocationsByNote:
SELECT location_id FROM note_locations WHERE note_id = ?;

selectNotesByLocation:
SELECT note_id FROM note_locations WHERE location_id = ?;

-- ─────────────────────────────────────────────────────────────────────────────
-- note_tags queries
-- ─────────────────────────────────────────────────────────────────────────────

insertNoteTag:
INSERT OR IGNORE INTO note_tags(note_id, tag_id) VALUES (?, ?);

deleteNoteTag:
DELETE FROM note_tags WHERE note_id = ? AND tag_id = ?;

selectTagsByNote:
SELECT tag_id FROM note_tags WHERE note_id = ?;

selectNotesByTag:
SELECT note_id FROM note_tags WHERE tag_id = ?;

