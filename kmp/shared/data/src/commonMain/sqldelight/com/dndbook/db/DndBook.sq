-- DND Book Database: Phase 0 skeleton schema
-- Full schema (all tables + join tables) will be written in Phase 1.
-- This file proves SQLDelight codegen works for the two root tables.

CREATE TABLE IF NOT EXISTS continuities (
  id           TEXT PRIMARY KEY NOT NULL,
  name         TEXT NOT NULL,
  description  TEXT NOT NULL DEFAULT '',
  hlc          TEXT NOT NULL,
  created      TEXT NOT NULL,
  updated      TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS campaigns (
  id             TEXT PRIMARY KEY NOT NULL,
  name           TEXT NOT NULL,
  continuity_id  TEXT NOT NULL REFERENCES continuities(id) ON DELETE CASCADE,
  hlc            TEXT NOT NULL,
  created        TEXT NOT NULL,
  updated        TEXT NOT NULL
);

-- ─────────────────────────────────────────────────────────────────────────────
-- Continuity queries
-- ─────────────────────────────────────────────────────────────────────────────

selectAllContinuities:
SELECT * FROM continuities ORDER BY updated DESC;

selectContinuityById:
SELECT * FROM continuities WHERE id = ?;

insertContinuity:
INSERT OR REPLACE INTO continuities(id, name, description, hlc, created, updated)
VALUES (?, ?, ?, ?, ?, ?);

updateContinuity:
UPDATE continuities SET name = ?, description = ?, hlc = ?, updated = ?
WHERE id = ?;

deleteContinuity:
DELETE FROM continuities WHERE id = ?;

-- ─────────────────────────────────────────────────────────────────────────────
-- Campaign queries
-- ─────────────────────────────────────────────────────────────────────────────

selectAllCampaigns:
SELECT * FROM campaigns ORDER BY updated DESC;

selectCampaignById:
SELECT * FROM campaigns WHERE id = ?;

selectCampaignsByContinuity:
SELECT * FROM campaigns WHERE continuity_id = ? ORDER BY updated DESC;

insertCampaign:
INSERT OR REPLACE INTO campaigns(id, name, continuity_id, hlc, created, updated)
VALUES (?, ?, ?, ?, ?, ?);

updateCampaign:
UPDATE campaigns SET name = ?, hlc = ?, updated = ?
WHERE id = ?;

deleteCampaign:
DELETE FROM campaigns WHERE id = ?;
